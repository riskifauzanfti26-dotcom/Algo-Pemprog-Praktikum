}
QPushButton#btnKembaliProses {
    background-color: #E67E22;
}
QPushButton#btnKembaliProses:hover {
    background-color: #D35400;
}
QTableWidget {
    background-color: white;
    border: 1px solid #BDC3C7;
    gridline-color: #ECF0F1;
}</string>
